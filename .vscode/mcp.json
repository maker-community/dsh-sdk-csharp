{
  "servers": {
    "dsh-csharp-local": {
      "type": "http",
      "url": "http://127.0.0.1:5211/mcp",
      "headers": {
        "Authorization": "Bearer ${input:dshMcpApiKey}",
        "X-User-Id": "${input:dshMcpUserId}",
        "X-User-Email": "${input:dshMcpUserEmail}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "dshMcpApiKey",
      "description": "Local DSH MCP API key (must match MCP_API_KEY)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "dshMcpUserId",
      "description": "Stable user/device ID from trusted gateway context"
    },
    {
      "type": "promptString",
      "id": "dshMcpUserEmail",
      "description": "Email address allowed by the MCP server"
    }
  ]
}
